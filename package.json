{
  "name": "pidashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:pm2": "pm2 start server.js --name pi-dashboard",
    "stop:pm2": "pm2 stop pi-dashboard",
    "restart:pm2": "pm2 restart pi-dashboard",
    "logs:pm2": "pm2 logs pi-dashboard",
    "lint": "node scripts/lint.js",
    "lint:fix": "node scripts/lint.js",
    "test": "node --test",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "clean": "rimraf node_modules",
    "rebuild": "git pull && npm install && npm run stop:pm2 && npm run start:pm2"
  },
  "keywords": [],
  "author": "Luke",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "express": "^5.1.0",
    "systeminformation": "^5.27.7"
  }
}
