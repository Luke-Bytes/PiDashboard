# Install as /etc/pi-dashboard/cloud-status.conf, root:root 0600.
PI_DASHBOARD_PROVIDERS=/srv/secure/rclone/providers.list
PI_DASHBOARD_RCLONE_CONFIG=/srv/secure/rclone/rclone.conf
PI_DASHBOARD_RCLONE_BINARY=/usr/bin/rclone
PI_DASHBOARD_PASSWORD_COMMAND=/usr/local/libexec/rclone-config-password
PI_DASHBOARD_CLOUD_CACHE=/var/lib/pi-dashboard/cloud-status.json
