#!/usr/bin/python3
"""Root-installed, one-way rclone quota cache collector.

Configuration is supplied by root-owned /etc/pi-dashboard/cloud-status.conf via
the systemd drop-in. This program emits no provider command output.
"""

import json
import os
import re
import subprocess
import tempfile
from datetime import datetime, timezone
from pathlib import Path

PROVIDER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")
EMAIL_RE = re.compile(r"^[^\s@]{1,64}@[^\s@]{1,189}$")
CACHE_PATH = Path(os.environ.get("PI_DASHBOARD_CLOUD_CACHE", "/var/lib/pi-dashboard/cloud-status.json"))
PROVIDERS_PATH = Path(os.environ.get("PI_DASHBOARD_PROVIDERS", "/srv/secure/rclone/pool/providers.list"))
RCLONE_CONFIG = os.environ.get("PI_DASHBOARD_RCLONE_CONFIG", "/srv/secure/rclone/pool/rclone.conf")
RCLONE_BINARY = os.environ.get("PI_DASHBOARD_RCLONE_BINARY", "/usr/local/bin/rclone-cloud")
RUNUSER_BINARY = os.environ.get("PI_DASHBOARD_RUNUSER_BINARY", "/usr/sbin/runuser")
PASSWORD_COMMAND = os.environ.get("PI_DASHBOARD_PASSWORD_COMMAND", "/usr/local/libexec/rclone-pool-config-pass")


def utc_now():
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def load_json(path, default):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default


def classify(message):
    text = message.lower()
    if "timeout" in text or "timed out" in text:
        return "timeout"
    if any(term in text for term in ("auth", "unauthorized", "forbidden", "invalid_grant", "401", "403")):
        return "authentication_failure"
    if "unsupported" in text or "not support" in text:
        return "quota_unsupported"
    return "unreachable"


def read_providers():
    names = []
    for line in PROVIDERS_PATH.read_text(encoding="utf-8").splitlines():
        name = line.strip()
        if not name or name.startswith("#"):
            continue
        if not PROVIDER_RE.fullmatch(name):
            raise ValueError("provider registry contains an invalid identifier")
        if name not in names:
            names.append(name)
    if not names:
        raise ValueError("provider registry contains no providers")
    return names


def validate_configuration():
    checks = (
        (PROVIDERS_PATH, "provider registry", False),
        (Path(RCLONE_CONFIG), "rclone config", False),
        (Path(RCLONE_BINARY), "rclone binary", True),
        (Path(RUNUSER_BINARY), "runuser binary", True),
    )
    if PASSWORD_COMMAND:
        checks += ((Path(PASSWORD_COMMAND.split()[0]), "password helper", True),)
    for path, label, executable in checks:
        if not path.is_absolute() or not path.is_file():
            raise RuntimeError(f"{label} is missing: {path}")
        if executable and not os.access(path, os.X_OK):
            raise RuntimeError(f"{label} is not executable: {path}")


def about(provider):
    command = [RUNUSER_BINARY, "-u", "jellyfin", "--", RCLONE_BINARY, "--config", RCLONE_CONFIG]
    if PASSWORD_COMMAND:
        command.extend(["--password-command", PASSWORD_COMMAND])
    command.extend(["about", f"{provider}:", "--json"])
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=90, check=False)
        if result.returncode:
            return None, classify(result.stderr)
        raw = json.loads(result.stdout)
        quota = {key: raw.get(key) if isinstance(raw.get(key), (int, float)) and raw.get(key) >= 0 else None for key in ("total", "used", "free", "trashed")}
        if all(quota[key] is None for key in ("total", "used", "free")):
            return None, "quota_unsupported"
        return quota, None
    except subprocess.TimeoutExpired:
        return None, "timeout"
    except (OSError, ValueError) as error:
        return None, classify(str(error))


def account_email(provider):
    """Read only an email-shaped identity from rclone's redacted configuration."""
    command = [RUNUSER_BINARY, "-u", "jellyfin", "--", RCLONE_BINARY, "--config", RCLONE_CONFIG]
    if PASSWORD_COMMAND:
        command.extend(["--password-command", PASSWORD_COMMAND])
    command.extend(["config", "redacted", provider])
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=30, check=False)
        if result.returncode:
            return None
        for line in result.stdout.splitlines():
            key, separator, value = line.partition("=")
            candidate = value.strip()
            if separator and key.strip().lower() in {"user", "username", "email", "account"} and EMAIL_RE.fullmatch(candidate):
                return candidate
    except (OSError, subprocess.TimeoutExpired):
        pass
    return None


def atomic_write(value):
    CACHE_PATH.parent.mkdir(mode=0o750, parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".cloud-status.", dir=CACHE_PATH.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o640)
        try:
            import pwd
            os.chown(temporary, 0, pwd.getpwnam("luke").pw_gid)
        except (KeyError, OSError):
            pass
        os.replace(temporary, CACHE_PATH)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def aggregate_field(quotas, key):
    values = [item.get(key) for item in quotas if isinstance(item.get(key), (int, float))]
    return sum(values) if values else None


def main():
    previous = load_json(CACHE_PATH, {"version": 1, "providerRegistry": [], "providers": {}})
    try:
        validate_configuration()
        providers = read_providers()
    except (OSError, ValueError, RuntimeError) as error:
        print(f"pi-dashboard cloud collector setup error: {error}", file=os.sys.stderr)
        return 2
    old = previous.get("providers", {}) if isinstance(previous.get("providers"), dict) else {}
    output = {"version": 1, "generatedAt": utc_now(), "providerRegistry": providers, "providers": {}}
    for provider in providers:
        prior = old.get(provider, {}) if isinstance(old.get(provider), dict) else {}
        attempt = utc_now()
        account = account_email(provider) or prior.get("account")
        quota, error = about(provider)
        if quota is not None:
            output["providers"][provider] = {"account": account, "quota": quota, "reachability": "ok", "lastAttempt": attempt, "lastSuccess": attempt, "errorCategory": None}
        else:
            output["providers"][provider] = {
                "account": account, "quota": prior.get("quota"), "reachability": "failed", "lastAttempt": attempt,
                "lastSuccess": prior.get("lastSuccess"), "errorCategory": error,
            }
    totals = [item.get("quota") for item in output["providers"].values() if isinstance(item.get("quota"), dict)]
    output["aggregate"] = {
        "reportedProviders": len(totals), "totalProviders": len(providers), "partial": len(totals) != len(providers),
        **{key: aggregate_field(totals, key) for key in ("total", "used", "free")},
    }
    atomic_write(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
